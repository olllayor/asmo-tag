ASMO_MODE=fixture
ASMO_DATABASE_PATH=work/asmo-fixture.sqlite
ASMO_PORT=8787
ASMO_HOST=127.0.0.1
ASMO_TASK_BUDGET_MICROS=2000000
ASMO_MODEL_RESERVE_MICROS=300000
ASMO_MAX_OUTPUT_TOKENS=2048
ASMO_MAX_TURNS=12
ASMO_LEASE_MS=60000

# Live model and Telegram setup. Choose a model and all three current prices.
# No fixture fallback occurs in live mode.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ASMO_MODEL_PROVIDER=openai
ASMO_MODEL=
OPENAI_API_KEY=
ASMO_INPUT_USD_PER_MILLION=
ASMO_CACHED_INPUT_USD_PER_MILLION=
ASMO_OUTPUT_USD_PER_MILLION=

# Optional alternative. Set ASMO_MODEL_PROVIDER=deepseek and its model/prices.
# DEEPSEEK_API_KEY=

# Optional Mini App direct link.
# ASMO_MINIAPP_LINK=

# Required for either live connector. Use a base64-encoded random 32-byte key.
# ASMO_CONNECTOR_VAULT_KEY=

# Optional GitHub App group. Configure every field together.
# ASMO_GITHUB_APP_ID=
# ASMO_GITHUB_CLIENT_ID=
# ASMO_GITHUB_CLIENT_SECRET=
# ASMO_GITHUB_PRIVATE_KEY=
# ASMO_GITHUB_APP_SLUG=
# ASMO_GITHUB_CALLBACK_URL=https://your-asmo-host.example/connectors/github/callback

# Optional Notion OAuth group. Configure every field together.
# ASMO_NOTION_CLIENT_ID=
# ASMO_NOTION_CLIENT_SECRET=
# ASMO_NOTION_CALLBACK_URL=https://your-asmo-host.example/connectors/notion/callback
